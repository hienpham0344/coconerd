# Public pages/demo need no credentials. The real dashboard requires Discord login.
HOST=127.0.0.1
PORT=5173
# Full, real Discord URLs. Leave empty until the bot is available.
DISCORD_INVITE_URL=
DISCORD_SUPPORT_URL=
# Optional public backend health endpoint. No private data is exposed.
# Example: http://127.0.0.1:8000/api/v1/health
COCONERD_STATUS_URL=

# Dashboard: SERVER-ONLY environment values. Never prefix these with VITE_.
# Register the exact callback in Discord Developer Portal, OAuth2 Redirects.
# Production example: https://your-domain.example/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Strong random secret, at least 32 bytes; stable across web instances/restarts.
DASHBOARD_SESSION_SECRET=
# Backend main API after applying the dashboard migration.
BACKEND_BASE_URL=
COCONERD_BOT_API_KEY=
COCONERD_ADMIN_API_KEY=
# Needed to list/validate the server's text channels.
DISCORD_BOT_TOKEN=
# Local development ONLY: http://127.0.0.1:5173/auth/discord/callback
COCONERD_WEB_ALLOW_HTTP=false
