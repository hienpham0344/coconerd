# DeepTrace AI Configuration

# Application
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Checkpointing
DATABASE_URL=sqlite:///./deeptrace.db
CHECKPOINT_DB_PATH=./deeptrace_checkpoints.db

# LLM Provider Configuration
# Set MOCK_LLM=true to test without API keys (mock mode with realistic synthetic responses)
MOCK_LLM=true
META_API_KEY=your_meta_or_together_api_key_here
META_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct
META_API_BASE=https://api.together.xyz/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# External Search Tools (optional - mock provider runs when omitted)
SERPER_API_KEY=
TAVILY_API_KEY=

# Workflow & Controller Bounds
MAX_RESEARCH_LOOPS=2
MIN_VERIFICATION_CONFIDENCE=0.70
MAX_CLAIMS_PER_RUN=15
TIMEOUT_PER_TOOL_SECONDS=15

# Observability & Logging
LOG_LEVEL=INFO
ENABLE_TRACING=true

# Discord Conversation Organizer backend (overrides the legacy generic values above)
COCONERD_APP_ENV=development
COCONERD_DATABASE_URL=sqlite+aiosqlite:///./data/coconerd.db
COCONERD_BOT_API_KEY=replace-with-random-bot-key
COCONERD_ADMIN_API_KEY=replace-with-a-separate-random-admin-key
COCONERD_MODEL_API_KEY=replace-with-meta-model-api-key
COCONERD_META_API_BASE=https://api.meta.ai/v1
COCONERD_META_MODEL_NAME=muse-spark-1.3
COCONERD_LLM_REASONING_EFFORT=low
COCONERD_LLM_MAX_TOKENS=2048
COCONERD_MOCK_LLM=true
COCONERD_TOPIC_DORMANT_AFTER_DAYS=30
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
ACTION_LEASE_SECONDS=60
MAX_REQUEST_BYTES=65536
MAX_MESSAGE_LENGTH=8000
RETENTION_DAYS=365

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APPLICATION_ID=your_application_id
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_ID=your_general_channel_id
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=your_mock_api_key

# Groq AI Configuration (Prototype experiment)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b


