# Coconerd backend configuration
# Copy to .env only when .env does not exist. Run API and worker from this checkout.
# Never put real credentials in this tracked template.

# Application
COCONERD_APP_ENV=development
COCONERD_DEBUG=false
COCONERD_HOST=0.0.0.0
COCONERD_PORT=8000
COCONERD_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COCONERD_LOG_LEVEL=INFO

# Storage (relative to the working directory)
COCONERD_DATABASE_URL=sqlite+aiosqlite:///./data/coconerd.db

# API authentication: use different random values for bot and admin.
# Not required for provider-only Meta evaluation.
COCONERD_BOT_API_KEY=
COCONERD_ADMIN_API_KEY=

# Meta Model API
# Fill the model key in .env and set mock mode to false for live classification.
COCONERD_MODEL_API_KEY=
COCONERD_META_API_BASE=https://api.meta.ai/v1
COCONERD_META_MODEL_NAME=muse-spark-1.3
COCONERD_MOCK_LLM=true
COCONERD_LLM_REASONING_EFFORT=low
COCONERD_LLM_MAX_TOKENS=2048

# Worker and Discord action delivery
COCONERD_WORKER_POLL_SECONDS=1
COCONERD_WORKER_LEASE_SECONDS=60
COCONERD_WORKER_MAX_ATTEMPTS=5
COCONERD_ACTION_LEASE_SECONDS=60

# Input and retention bounds
COCONERD_MAX_REQUEST_BYTES=65536
COCONERD_MAX_MESSAGE_LENGTH=8000
COCONERD_RETENTION_DAYS=365
COCONERD_TOPIC_DORMANT_AFTER_DAYS=30
